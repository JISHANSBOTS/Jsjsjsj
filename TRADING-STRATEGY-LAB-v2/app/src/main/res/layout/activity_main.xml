<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101827" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="TRADING STRATEGY LAB" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="23sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Research • Backtest • Paper trading" android:textColor="#AAB7CC"
            android:layout_marginTop="5dp" android:layout_marginBottom="18dp"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Ready — import historical candles to begin."
            android:textColor="#DCE6F5" android:background="#1C2A40" android:padding="14dp"/>
        <Spinner android:id="@+id/marketSpinner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
        <Spinner android:id="@+id/timeframeSpinner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/importButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Import historical CSV"/>
        <Button android:id="@+id/exportButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Export selected candles"/>
        <Button android:id="@+id/generateButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Generate strategy candidates"/>
        <Button android:id="@+id/backtestButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Run EMA / RSI backtest"/>
        <Button android:id="@+id/scheduleButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Schedule daily research check"/>
        <TextView android:id="@+id/resultsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="14sp" android:padding="14dp" android:text="No results yet."/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Research and paper-trading prototype only. No broker execution. Backtests do not predict future returns."
            android:textColor="#F0C879" android:textSize="12sp" android:paddingTop="12dp"/>
    </LinearLayout>
</ScrollView>
